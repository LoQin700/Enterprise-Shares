{%- liquid
  assign author = metaobject
  assign name_key = settings.es_author_name_key | default: 'display_name'
  assign avatar_key = settings.es_author_avatar_key | default: 'avatar'
  assign bio_key = settings.es_author_bio_key | default: 'bio'
  assign projects_key = settings.es_author_collection_key | default: 'projects_collection'
  assign joined_key = settings.es_author_joined_key | default: 'joined_date'

  assign author_name_field = author[name_key]
  assign author_avatar_field = author[avatar_key]
  assign author_bio_field = author[bio_key]
  assign author_projects_field = author[projects_key]
  assign author_joined_field = author[joined_key]

  if author_joined_field == blank
    assign author_joined_field = author['Date']
  endif
  if author_joined_field == blank
    assign author_joined_field = author['date']
  endif
  if author_joined_field == blank
    assign author_joined_field = author['joined_date']
  endif

  assign author_name = author_name_field.value | default: author.system.handle
  assign author_avatar = author_avatar_field.value
  assign author_bio = author_bio_field.value

  assign author_projects = blank
  assign project_count = 0

  if author_projects_field != blank
    assign projects_value = author_projects_field.value

    if author_projects_field.type contains 'list.'
      assign author_projects = projects_value
      assign project_count = author_projects.size
    elsif author_projects_field.type == 'collection_reference'
      assign author_projects = projects_value.products
      assign project_count = projects_value.products_count
    elsif projects_value.products_count != blank
      assign author_projects = projects_value.products
      assign project_count = projects_value.products_count
    else
      assign author_projects = projects_value
      assign project_count = author_projects.size
    endif
  endif

  assign card_ratio = settings.es_card_ratio | default: '16/9'
-%}

<section
  class="es-author-page color-{{ section.settings.color_scheme }}"
  style="
    --es-author-avatar-size: {{ section.settings.avatar_size }}px;
    --es-author-avatar-radius: {{ section.settings.avatar_radius }}%;
    --es-author-title-size: {{ section.settings.title_size }}px;
    --es-author-bio-size: {{ section.settings.bio_size }}px;
    --es-author-grid-columns: {{ section.settings.desktop_columns }};
    --es-author-grid-columns-mobile: {{ section.settings.mobile_columns }};
    --es-author-grid-gap: {{ section.settings.grid_gap }}px;
    --es-author-padding-top: {{ section.settings.padding_top }}px;
    --es-author-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="es-author-page__inner{% if section.settings.section_width == 'page-width' %} page-width{% endif %}">
    <header class="es-author-page__hero">
      <div class="es-author-page__avatar-wrap">
        {%- if author_avatar -%}
          {{ author_avatar | image_url: width: 600 | image_tag: class: 'es-author-page__avatar', loading: 'eager', alt: author_name }}
        {%- else -%}
          <span class="es-author-page__avatar es-author-page__avatar--fallback" aria-hidden="true">{{ author_name | slice: 0 | upcase }}</span>
        {%- endif -%}
      </div>

      <h1 class="es-author-page__title">{{ author_name }}</h1>

      {%- if section.settings.show_joined or section.settings.show_project_count -%}
        <div class="es-author-page__meta">
          {%- if section.settings.show_joined and author_joined_field != blank -%}
            <span>Joined {{ author_joined_field.value | date: '%B %Y' }}</span>
          {%- endif -%}
          {%- if section.settings.show_joined and author_joined_field != blank and section.settings.show_project_count and project_count > 0 -%}
            <span class="es-author-page__meta-separator" aria-hidden="true">•</span>
          {%- endif -%}
          {%- if section.settings.show_project_count and project_count > 0 -%}
            <span>{{ project_count }} Projects</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if author_bio != blank -%}
        <div class="es-author-page__bio rte">{{ author_bio_field | metafield_tag }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.show_projects and project_count > 0 and author_projects != blank -%}
      <div class="es-author-page__projects">
        <div class="es-author-page__projects-heading">
          <h2>{{ section.settings.projects_heading | default: 'Created Projects' }}</h2>
          <span>{{ project_count }}</span>
        </div>

        <div class="es-author-page__grid">
          {%- for linked_product in author_projects limit: section.settings.project_limit -%}
            {% render 'es-product-card-router', product: linked_product, variant: 'compact', image_ratio: card_ratio, force_custom: true, hide_author: true %}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .es-author-page {
    padding-top: var(--es-author-padding-top);
    padding-bottom: var(--es-author-padding-bottom);
  }

  .es-author-page__inner {
    width: 100%;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .es-author-page__inner.page-width {
    max-width: var(--page-width);
  }

  .es-author-page__hero {
    display: flex;
    max-width: 860px;
    margin-inline: auto;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .es-author-page__avatar-wrap {
    width: var(--es-author-avatar-size);
    height: var(--es-author-avatar-size);
    flex: 0 0 var(--es-author-avatar-size);
  }

  .es-author-page__avatar {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--es-author-avatar-radius);
    object-fit: cover;
    background: rgb(var(--color-foreground-rgb, 18 18 18) / 0.06);
  }

  .es-author-page__avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: calc(var(--es-author-avatar-size) * 0.38);
    font-weight: 700;
  }

  .es-author-page__title {
    margin: 24px 0 0;
    color: var(--color-foreground-heading, var(--color-foreground));
    font-family: var(--font-heading--family, inherit);
    font-size: var(--es-author-title-size);
    font-weight: 700;
    line-height: 1.15;
  }

  .es-author-page__meta {
    display: flex;
    margin-top: 14px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    color: rgb(var(--color-foreground-rgb, 18 18 18) / 0.62);
    font-size: 1.4rem;
  }

  .es-author-page__bio {
    max-width: 720px;
    margin-top: 26px;
    font-size: var(--es-author-bio-size);
    line-height: 1.7;
  }

  .es-author-page__bio p {
    margin-top: 0;
  }

  .es-author-page__bio p:last-child {
    margin-bottom: 0;
  }

  .es-author-page__projects {
    margin-top: 56px;
  }

  .es-author-page__projects-heading {
    display: flex;
    margin-bottom: 24px;
    align-items: baseline;
    gap: 10px;
  }

  .es-author-page__projects-heading h2 {
    margin: 0;
    color: var(--color-foreground-heading, var(--color-foreground));
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(2.2rem, 3vw, 3.2rem);
    line-height: 1.2;
  }

  .es-author-page__projects-heading span {
    color: rgb(var(--color-foreground-rgb, 18 18 18) / 0.58);
    font-size: 1.4rem;
  }

  .es-author-page__grid {
    display: grid;
    grid-template-columns: repeat(var(--es-author-grid-columns), minmax(0, 1fr));
    gap: var(--es-author-grid-gap);
  }

  @media screen and (max-width: 749px) {
    .es-author-page__inner {
      padding-inline: 16px;
    }

    .es-author-page__avatar-wrap {
      width: min(var(--es-author-avatar-size), 150px);
      height: min(var(--es-author-avatar-size), 150px);
      flex-basis: min(var(--es-author-avatar-size), 150px);
    }

    .es-author-page__title {
      margin-top: 18px;
    }

    .es-author-page__bio {
      margin-top: 20px;
    }

    .es-author-page__projects {
      margin-top: 40px;
    }

    .es-author-page__grid {
      grid-template-columns: repeat(var(--es-author-grid-columns-mobile), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "作者介绍页面",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "default": "page-width",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "颜色方案",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "作者头像尺寸",
      "min": 96,
      "max": 240,
      "step": 8,
      "unit": "px",
      "default": 160
    },
    {
      "type": "range",
      "id": "avatar_radius",
      "label": "作者头像圆角",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "作者名称字号",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "bio_size",
      "label": "作者简介字号",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "checkbox",
      "id": "show_joined",
      "label": "显示加入时间",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_project_count",
      "label": "显示项目数量",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_projects",
      "label": "显示关联项目",
      "default": true
    },
    {
      "type": "text",
      "id": "projects_heading",
      "label": "项目区域标题",
      "default": "Created Projects"
    },
    {
      "type": "range",
      "id": "project_limit",
      "label": "最多显示项目数量",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "电脑端每行项目数",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "手机端每行项目数",
      "default": "2",
      "options": [
        { "value": "1", "label": "1个" },
        { "value": "2", "label": "2个" }
      ]
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "项目间距",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "顶部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "底部间距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
