<section
  class="es-project-process color-{{ section.settings.color_scheme }}"
  style="
    --es-process-width: {{ section.settings.section_width }}px;
    --es-process-heading: {{ section.settings.heading_size }}px;
    --es-process-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --es-process-card-heading: {{ section.settings.card_heading_size }}px;
    --es-process-text: {{ section.settings.text_size }}px;
    --es-process-radius: {{ section.settings.card_radius }}px;
    --es-process-gap: {{ section.settings.card_gap }}px;
    --es-process-pt: {{ section.settings.padding_top }}px;
    --es-process-pb: {{ section.settings.padding_bottom }}px;
    --es-process-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --es-process-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="es-project-process__inner">
    <div class="es-project-process__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="es-project-process__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {% if section.settings.text != blank %}
        <div class="rte es-project-process__intro">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="es-project-process__grid">
      {% for index in (1..3) %}
        {% liquid
          assign title_key = 'step_' | append: index | append: '_heading'
          assign text_key = 'step_' | append: index | append: '_text'
        %}
        <article class="es-project-process__card">
          <span class="es-project-process__number">0{{ index }}</span>
          <h3>{{ section.settings[title_key] | escape }}</h3>
          <div class="rte">{{ section.settings[text_key] }}</div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .es-project-process {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .es-project-process__inner {
    width: min(var(--es-process-width), calc(100% - 40px));
    margin: 0 auto;
    padding-top: var(--es-process-pt);
    padding-bottom: var(--es-process-pb);
  }

  .es-project-process__header {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(280px, 0.55fr);
    gap: 56px;
    align-items: end;
    margin-bottom: 48px;
  }

  .es-project-process__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .es-project-process__header h2 {
    margin: 0;
    font-size: var(--es-process-heading);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .es-project-process__intro {
    font-size: var(--es-process-text);
    line-height: 1.7;
    opacity: 0.72;
  }

  .es-project-process__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--es-process-gap);
  }

  .es-project-process__card {
    position: relative;
    min-height: 300px;
    padding: 30px;
    overflow: hidden;
    border: 1px solid rgba(var(--color-foreground), 0.14);
    border-radius: var(--es-process-radius);
    background: rgba(var(--color-foreground), 0.025);
  }

  .es-project-process__card::after {
    content: "";
    position: absolute;
    right: -46px;
    bottom: -70px;
    width: 160px;
    height: 160px;
    border-radius: 999px;
    background: rgba(var(--color-foreground), 0.045);
  }

  .es-project-process__number {
    display: block;
    margin-bottom: 72px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.52;
  }

  .es-project-process__card h3 {
    position: relative;
    z-index: 1;
    margin: 0 0 14px;
    font-size: var(--es-process-card-heading);
    line-height: 1.2;
  }

  .es-project-process__card .rte {
    position: relative;
    z-index: 1;
    font-size: var(--es-process-text);
    line-height: 1.65;
    opacity: 0.72;
  }

  .es-project-process .rte > :first-child {
    margin-top: 0;
  }

  .es-project-process .rte > :last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .es-project-process__inner {
      width: min(var(--es-process-width), calc(100% - 28px));
      padding-top: var(--es-process-pt-mobile);
      padding-bottom: var(--es-process-pb-mobile);
    }

    .es-project-process__header {
      display: block;
      margin-bottom: 32px;
    }

    .es-project-process__header h2 {
      margin-bottom: 16px;
      font-size: var(--es-process-heading-mobile);
    }

    .es-project-process__grid {
      grid-template-columns: 1fr;
    }

    .es-project-process__card {
      min-height: 0;
      padding: 24px;
    }

    .es-project-process__number {
      margin-bottom: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "项目申请｜流程",
  "class": "section-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "配色方案", "default": "scheme-2" },
    { "type": "text", "id": "eyebrow", "label": "顶部小标题", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "标题", "default": "A clear path from idea to review" },
    { "type": "richtext", "id": "text", "label": "简短说明", "default": "<p>Submitting the form starts a review. Approved projects move forward through direct communication with our team.</p>" },
    { "type": "header", "content": "步骤一" },
    { "type": "text", "id": "step_1_heading", "label": "标题", "default": "Apply" },
    { "type": "richtext", "id": "step_1_text", "label": "说明", "default": "<p>Share the essential project, team, funding, and delivery information.</p>" },
    { "type": "header", "content": "步骤二" },
    { "type": "text", "id": "step_2_heading", "label": "标题", "default": "Review" },
    { "type": "richtext", "id": "step_2_text", "label": "说明", "default": "<p>We review feasibility, materials, positioning, and platform suitability.</p>" },
    { "type": "header", "content": "步骤三" },
    { "type": "text", "id": "step_3_heading", "label": "标题", "default": "Discuss" },
    { "type": "richtext", "id": "step_3_text", "label": "说明", "default": "<p>Suitable applicants are contacted to confirm details and next steps.</p>" },
    { "type": "header", "content": "布局与尺寸" },
    { "type": "range", "id": "section_width", "label": "内容最大宽度", "min": 900, "max": 1440, "step": 20, "unit": "px", "default": 1180 },
    { "type": "range", "id": "heading_size", "label": "标题字号", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "heading_size_mobile", "label": "移动端标题字号", "min": 24, "max": 44, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "card_heading_size", "label": "卡片标题字号", "min": 18, "max": 32, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "text_size", "label": "正文字号", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "卡片圆角", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_gap", "label": "卡片间距", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_top", "label": "桌面端上间距", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "桌面端下间距", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "移动端上间距", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "移动端下间距", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [{ "name": "项目申请｜流程" }]
}
{% endschema %}