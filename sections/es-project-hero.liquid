<section
  class="es-project-hero es-project-hero--{{ section.settings.alignment }} color-{{ section.settings.color_scheme }}"
  style="
    --es-hero-max: {{ section.settings.content_width }}px;
    --es-hero-heading: {{ section.settings.heading_size }}px;
    --es-hero-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --es-hero-text: {{ section.settings.text_size }}px;
    --es-hero-text-mobile: {{ section.settings.text_size_mobile }}px;
    --es-hero-pt: {{ section.settings.padding_top }}px;
    --es-hero-pb: {{ section.settings.padding_bottom }}px;
    --es-hero-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --es-hero-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="es-project-hero__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="es-project-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1>{{ section.settings.heading | escape }}</h1>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="es-project-hero__text rte">{{ section.settings.text }}</div>
    {% endif %}

    {% if section.settings.show_button %}
      <a
        class="button es-project-hero__button"
        href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}#project-application-form{% endif %}"
      >
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .es-project-hero {
    position: relative;
    overflow: hidden;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .es-project-hero::before,
  .es-project-hero::after {
    content: "";
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
    background: rgba(var(--color-foreground), 0.045);
  }

  .es-project-hero::before {
    width: 420px;
    height: 420px;
    top: -250px;
    right: -130px;
  }

  .es-project-hero::after {
    width: 220px;
    height: 220px;
    bottom: -150px;
    left: -80px;
  }

  .es-project-hero__inner {
    position: relative;
    z-index: 1;
    width: min(var(--es-hero-max), calc(100% - 40px));
    margin: 0 auto;
    padding-top: var(--es-hero-pt);
    padding-bottom: var(--es-hero-pb);
  }

  .es-project-hero--center .es-project-hero__inner {
    text-align: center;
  }

  .es-project-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    margin: 0 0 20px;
    padding: 6px 12px;
    border: 1px solid rgba(var(--color-foreground), 0.16);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .es-project-hero h1 {
    max-width: 980px;
    margin: 0 0 24px;
    font-size: var(--es-hero-heading);
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .es-project-hero--center h1 {
    margin-left: auto;
    margin-right: auto;
  }

  .es-project-hero__text {
    max-width: 720px;
    font-size: var(--es-hero-text);
    line-height: 1.7;
    opacity: 0.78;
  }

  .es-project-hero--center .es-project-hero__text {
    margin-left: auto;
    margin-right: auto;
  }

  .es-project-hero__button {
    margin-top: 32px;
  }

  .es-project-hero .rte > :first-child {
    margin-top: 0;
  }

  .es-project-hero .rte > :last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .es-project-hero__inner {
      width: min(var(--es-hero-max), calc(100% - 28px));
      padding-top: var(--es-hero-pt-mobile);
      padding-bottom: var(--es-hero-pb-mobile);
    }

    .es-project-hero h1 {
      font-size: var(--es-hero-heading-mobile);
      letter-spacing: -0.035em;
    }

    .es-project-hero__text {
      font-size: var(--es-hero-text-mobile);
    }

    .es-project-hero::before {
      width: 280px;
      height: 280px;
      top: -180px;
      right: -110px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "项目申请｜首屏",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "配色方案",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "内容对齐",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "顶部小标题",
      "default": "Project application"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "主标题",
      "default": "Launch Your Dream Project"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "介绍文案",
      "default": "<p>Share your idea, your team, and the change you want to create. We review every application before discussing the next stage.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "显示按钮",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "按钮文案",
      "default": "Start your application"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接（留空则跳转到表单）"
    },
    {
      "type": "header",
      "content": "桌面端尺寸"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "内容最大宽度",
      "min": 600,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 920
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题字号",
      "min": 36,
      "max": 88,
      "step": 2,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "正文字号",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上间距",
      "min": 20,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下间距",
      "min": 20,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 104
    },
    {
      "type": "header",
      "content": "移动端尺寸"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "移动端标题字号",
      "min": 28,
      "max": 56,
      "step": 1,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "移动端正文字号",
      "min": 13,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "移动端上间距",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "移动端下间距",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 68
    }
  ],
  "presets": [
    {
      "name": "项目申请｜首屏"
    }
  ]
}
{% endschema %}