{% capture form_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

<section class="es-project-application color-{{ section.settings.color_scheme }}" id="project-application">
  <div class="es-project-application__hero">
    <div class="es-project-application__container es-project-application__container--narrow">
      {% if section.settings.eyebrow != blank %}
        <p class="es-project-application__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      <div class="es-project-application__lead rte">{{ section.settings.intro }}</div>
    </div>
  </div>

  <div class="es-project-application__container">
    <div class="es-project-application__section">
      <div class="es-project-application__heading">
        <h2>{{ section.settings.process_heading | escape }}</h2>
        <div class="rte">{{ section.settings.process_intro }}</div>
      </div>
      <div class="es-project-application__steps">
        <article class="es-project-application__card">
          <span>01</span>
          <h3>{{ section.settings.step_1_heading | escape }}</h3>
          <div class="rte">{{ section.settings.step_1_text }}</div>
        </article>
        <article class="es-project-application__card">
          <span>02</span>
          <h3>{{ section.settings.step_2_heading | escape }}</h3>
          <div class="rte">{{ section.settings.step_2_text }}</div>
        </article>
        <article class="es-project-application__card">
          <span>03</span>
          <h3>{{ section.settings.step_3_heading | escape }}</h3>
          <div class="rte">{{ section.settings.step_3_text }}</div>
        </article>
      </div>
    </div>

    <div class="es-project-application__section es-project-application__section--soft">
      <div class="es-project-application__heading">
        <h2>{{ section.settings.prepare_heading | escape }}</h2>
        <div class="rte">{{ section.settings.prepare_intro }}</div>
      </div>
      <div class="es-project-application__columns">
        <article class="es-project-application__panel">
          <h3>{{ section.settings.project_info_heading | escape }}</h3>
          <div class="rte">{{ section.settings.project_info_text }}</div>
        </article>
        <article class="es-project-application__panel">
          <h3>{{ section.settings.files_heading | escape }}</h3>
          <div class="rte">{{ section.settings.files_text }}</div>
        </article>
      </div>
    </div>

    <div class="es-project-application__notice">
      <div>
        <p class="es-project-application__eyebrow">{{ section.settings.file_eyebrow | escape }}</p>
        <h2>{{ section.settings.file_heading | escape }}</h2>
      </div>
      <div class="rte">{{ section.settings.file_text }}</div>
    </div>

    <div class="es-project-application__form-wrap">
      <div class="es-project-application__heading">
        <h2>{{ section.settings.form_heading | escape }}</h2>
        <div class="rte">{{ section.settings.form_intro }}</div>
      </div>
      <div class="es-project-application__form">
        {% if form_blocks != blank %}
          {{ form_blocks }}
        {% else %}
          <div class="es-project-application__placeholder">
            <strong>Add the Shopify Forms app block here.</strong>
            <p>Open this template in the theme editor, select this section, click Add block, choose Apps → Forms, and paste your Form ID.</p>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="es-project-application__after">
      <h2>{{ section.settings.after_heading | escape }}</h2>
      <div class="rte">{{ section.settings.after_text }}</div>
    </div>
  </div>
</section>

{% stylesheet %}
  .es-project-application {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .es-project-application__container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  .es-project-application__container--narrow {
    width: min(780px, calc(100% - 40px));
    text-align: center;
  }

  .es-project-application__hero {
    padding: 96px 0 88px;
    background: rgb(var(--color-background));
  }

  .es-project-application__hero h1 {
    margin: 12px 0 20px;
    font-size: clamp(42px, 6vw, 76px);
    line-height: 1.04;
    letter-spacing: -0.04em;
  }

  .es-project-application__lead {
    max-width: 720px;
    margin: 0 auto;
    font-size: 18px;
    line-height: 1.75;
    opacity: 0.8;
  }

  .es-project-application__eyebrow {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .es-project-application__section,
  .es-project-application__form-wrap {
    padding: 80px 0;
  }

  .es-project-application__section--soft {
    padding: 64px;
    border-radius: 24px;
    background: rgba(var(--color-foreground), 0.045);
  }

  .es-project-application__heading {
    max-width: 760px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .es-project-application__heading h2,
  .es-project-application__notice h2,
  .es-project-application__after h2 {
    margin: 0 0 14px;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .es-project-application__steps,
  .es-project-application__columns {
    display: grid;
    gap: 24px;
  }

  .es-project-application__steps {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .es-project-application__columns {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .es-project-application__card,
  .es-project-application__panel {
    padding: 30px;
    border: 1px solid rgba(var(--color-foreground), 0.14);
    border-radius: 18px;
    background: rgb(var(--color-background));
  }

  .es-project-application__card > span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 36px;
    border-radius: 50%;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-size: 12px;
    font-weight: 700;
  }

  .es-project-application__card h3,
  .es-project-application__panel h3 {
    margin: 0 0 12px;
    font-size: 22px;
  }

  .es-project-application__notice {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
    gap: 48px;
    align-items: start;
    margin: 80px 0 0;
    padding: 48px;
    border-radius: 20px;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }

  .es-project-application__form {
    max-width: 900px;
    margin: 0 auto;
  }

  .es-project-application__placeholder {
    padding: 36px;
    border: 1px dashed rgba(var(--color-foreground), 0.35);
    border-radius: 16px;
    text-align: center;
    background: rgba(var(--color-foreground), 0.035);
  }

  .es-project-application__placeholder p {
    margin: 8px 0 0;
  }

  .es-project-application__after {
    max-width: 850px;
    margin: 0 auto;
    padding: 64px 0 88px;
    text-align: center;
  }

  .es-project-application .rte > :first-child {
    margin-top: 0;
  }

  .es-project-application .rte > :last-child {
    margin-bottom: 0;
  }

  .es-project-application .rte ul {
    padding-left: 20px;
  }

  .es-project-application .rte li + li {
    margin-top: 8px;
  }

  @media screen and (max-width: 749px) {
    .es-project-application__container,
    .es-project-application__container--narrow {
      width: min(100% - 28px, 1180px);
    }

    .es-project-application__hero {
      padding: 64px 0 56px;
    }

    .es-project-application__section,
    .es-project-application__form-wrap {
      padding: 56px 0;
    }

    .es-project-application__section--soft {
      padding: 36px 20px;
      border-radius: 18px;
    }

    .es-project-application__steps,
    .es-project-application__columns,
    .es-project-application__notice {
      grid-template-columns: 1fr;
    }

    .es-project-application__notice {
      gap: 20px;
      margin-top: 56px;
      padding: 32px 24px;
    }

    .es-project-application__card,
    .es-project-application__panel {
      padding: 24px;
    }

    .es-project-application__card > span {
      margin-bottom: 24px;
    }

    .es-project-application__after {
      padding: 48px 0 64px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Project application page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Project application"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Launch Your Dream Project"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Tell us about your idea, your team, and the impact you want to create. Complete the application below so our team can review your project and contact you about the next steps.</p>"
    },
    {
      "type": "header",
      "content": "Application process"
    },
    {
      "type": "text",
      "id": "process_heading",
      "label": "Heading",
      "default": "How the application works"
    },
    {
      "type": "richtext",
      "id": "process_intro",
      "label": "Introduction",
      "default": "<p>Your submission is an application for review. It does not automatically publish a crowdfunding project or guarantee approval.</p>"
    },
    {
      "type": "text",
      "id": "step_1_heading",
      "label": "Step 1 heading",
      "default": "Submit your application"
    },
    {
      "type": "richtext",
      "id": "step_1_text",
      "label": "Step 1 text",
      "default": "<p>Complete the form and provide the clearest available information about your project.</p>"
    },
    {
      "type": "text",
      "id": "step_2_heading",
      "label": "Step 2 heading",
      "default": "Project review"
    },
    {
      "type": "richtext",
      "id": "step_2_text",
      "label": "Step 2 text",
      "default": "<p>Our team reviews the project information, materials, feasibility, and suitability for the platform.</p>"
    },
    {
      "type": "text",
      "id": "step_3_heading",
      "label": "Step 3 heading",
      "default": "Follow-up and launch"
    },
    {
      "type": "richtext",
      "id": "step_3_text",
      "label": "Step 3 text",
      "default": "<p>If the project is suitable, we will contact you to confirm details, request additional materials, and discuss publication.</p>"
    },
    {
      "type": "header",
      "content": "Preparation"
    },
    {
      "type": "text",
      "id": "prepare_heading",
      "label": "Heading",
      "default": "Prepare before you begin"
    },
    {
      "type": "richtext",
      "id": "prepare_intro",
      "label": "Introduction",
      "default": "<p>Having the following materials ready will make the application faster and help us understand your project.</p>"
    },
    {
      "type": "text",
      "id": "project_info_heading",
      "label": "Project information heading",
      "default": "Project information"
    },
    {
      "type": "richtext",
      "id": "project_info_text",
      "label": "Project information text",
      "default": "<ul><li>Project name, category, industry, and location</li><li>Clear project description and fundraising goal</li><li>Team or founder introduction</li><li>Project origin, current progress, and implementation plan</li><li>Reward, delivery, risk, and sustainability information</li></ul>"
    },
    {
      "type": "text",
      "id": "files_heading",
      "label": "Files heading",
      "default": "Files and media"
    },
    {
      "type": "richtext",
      "id": "files_text",
      "label": "Files text",
      "default": "<ul><li>Up to three representative project images</li><li>Business license or supporting PDF when applicable</li><li>Project video link when available</li><li>A public cloud-storage link for ZIP files, source files, videos, or additional materials</li></ul>"
    },
    {
      "type": "header",
      "content": "File guidance"
    },
    {
      "type": "text",
      "id": "file_eyebrow",
      "label": "Eyebrow",
      "default": "Before uploading"
    },
    {
      "type": "text",
      "id": "file_heading",
      "label": "Heading",
      "default": "File submission guidance"
    },
    {
      "type": "richtext",
      "id": "file_text",
      "label": "Text",
      "default": "<p>Use the upload fields for supported images or PDF documents up to 20 MB each. For ZIP files, large videos, source files, or additional documents, upload them to Google Drive, Dropbox, OneDrive, or another cloud service and paste a public sharing link into the form.</p><p><strong>Important:</strong> Set the link permission to anyone with the link can view or download.</p>"
    },
    {
      "type": "header",
      "content": "Form area"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Heading",
      "default": "Project Application Form"
    },
    {
      "type": "richtext",
      "id": "form_intro",
      "label": "Introduction",
      "default": "<p>Complete all required fields. Optional questions can be left blank when they do not apply to your project.</p>"
    },
    {
      "type": "header",
      "content": "After submission"
    },
    {
      "type": "text",
      "id": "after_heading",
      "label": "Heading",
      "default": "What happens after submission?"
    },
    {
      "type": "richtext",
      "id": "after_text",
      "label": "Text",
      "default": "<p>You will see a confirmation message after the form is submitted successfully. Our team will review the information provided and contact you by email when we need clarification, additional materials, or wish to discuss the next stage.</p><p>Please ensure your email address and cloud-file permissions remain valid. Submitting an application does not guarantee approval, funding, investment, publication, or financial returns.</p>"
    }
  ],
  "presets": [
    {
      "name": "Project application page"
    }
  ]
}
{% endschema %}