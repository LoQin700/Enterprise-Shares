{% liquid
  assign layout_width = section.settings.layout_width | default: 'page'
  assign card_scheme = section.settings.card_color_scheme | default: section.settings.color_scheme
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="es-info-cards section page-width-normal color-{{ section.settings.color_scheme }}{% if layout_width == 'full' %} section--full-width section--full-width-margin{% else %} section--page-width{% endif %}"
  style="
    --es-info-heading: {{ section.settings.heading_size }}px;
    --es-info-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --es-info-card-heading: {{ section.settings.card_heading_size }}px;
    --es-info-text: {{ section.settings.text_size }}px;
    --es-info-radius: {{ section.settings.card_radius }}px;
    --es-info-gap: {{ section.settings.card_gap }}px;
    --es-info-columns: {{ section.settings.columns }};
    --es-info-pt: {{ section.settings.padding_top }}px;
    --es-info-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="es-info-cards__inner">
    <div class="es-info-cards__header es-info-cards__header--{{ section.settings.alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="es-info-cards__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="rte es-info-cards__intro">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="es-info-cards__grid">
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          <article class="es-info-cards__card color-{{ card_scheme }}" {{ block.shopify_attributes }}>
            {% if block.settings.badge != blank %}
              <span class="es-info-cards__badge">{{ block.settings.badge | escape }}</span>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading | escape }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="rte">{{ block.settings.text }}</div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% for block in section.blocks %}
      {% if block.type == 'notice' %}
        <aside class="es-info-cards__notice" {{ block.shopify_attributes }}>
          <div>
            {% if block.settings.badge != blank %}
              <span class="es-info-cards__notice-label">{{ block.settings.badge | escape }}</span>
            {% endif %}
            {% if block.settings.heading != blank %}
              <strong>{{ block.settings.heading | escape }}</strong>
            {% endif %}
          </div>
          {% if block.settings.text != blank %}
            <div class="rte">{{ block.settings.text }}</div>
          {% endif %}
        </aside>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .es-info-cards {
    color: var(--color-foreground);
  }

  .es-info-cards__inner {
    width: 100%;
    padding-top: var(--es-info-pt);
    padding-bottom: var(--es-info-pb);
  }

  .es-info-cards__header {
    max-width: 820px;
    margin-bottom: 38px;
  }

  .es-info-cards__header--center {
    margin-right: auto;
    margin-left: auto;
    text-align: center;
  }

  .es-info-cards__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .es-info-cards__header h2 {
    margin: 0 0 14px;
    font-size: var(--es-info-heading);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .es-info-cards__intro,
  .es-info-cards__card .rte,
  .es-info-cards__notice .rte {
    font-size: var(--es-info-text);
    line-height: 1.7;
  }

  .es-info-cards__intro,
  .es-info-cards__card .rte {
    opacity: 0.74;
  }

  .es-info-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--es-info-columns), minmax(0, 1fr));
    gap: var(--es-info-gap);
  }

  .es-info-cards__card {
    min-width: 0;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: var(--es-info-radius);
    color: var(--color-foreground);
    background: var(--color-background);
    box-shadow: 0 14px 34px rgb(var(--color-shadow-rgb) / 0.06);
  }

  .es-info-cards__badge {
    display: inline-flex;
    min-height: 28px;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    padding: 5px 12px;
    border-radius: 999px;
    color: var(--color-background);
    background: var(--color-foreground);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .es-info-cards__card h3 {
    margin: 0 0 14px;
    font-size: var(--es-info-card-heading);
    line-height: 1.2;
  }

  .es-info-cards__notice {
    display: grid;
    grid-template-columns: minmax(180px, 0.34fr) minmax(0, 1fr);
    gap: 36px;
    align-items: start;
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--color-border);
  }

  .es-info-cards__notice-label {
    display: block;
    margin-bottom: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .es-info-cards__notice strong {
    display: block;
    font-size: 15px;
  }

  .es-info-cards .rte > :first-child {
    margin-top: 0;
  }

  .es-info-cards .rte > :last-child {
    margin-bottom: 0;
  }

  .es-info-cards .rte ul {
    padding-left: 20px;
  }

  .es-info-cards .rte li + li {
    margin-top: 7px;
  }

  @media screen and (max-width: 989px) {
    .es-info-cards__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .es-info-cards.section--full-width .es-info-cards__inner {
      padding-inline: var(--page-margin);
    }

    .es-info-cards__header h2 {
      font-size: var(--es-info-heading-mobile);
    }

    .es-info-cards__grid,
    .es-info-cards__notice {
      grid-template-columns: 1fr;
    }

    .es-info-cards__card {
      padding: 24px 22px;
    }

    .es-info-cards__notice {
      gap: 8px;
      padding-top: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "信息卡片",
  "class": "section-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Section 配色方案", "default": "scheme-1" },
    { "type": "color_scheme", "id": "card_color_scheme", "label": "卡片配色方案", "default": "scheme-2" },
    { "type": "select", "id": "layout_width", "label": "Section 宽度", "options": [{ "value": "page", "label": "页面宽度" }, { "value": "full", "label": "全宽" }], "default": "page" },
    { "type": "select", "id": "alignment", "label": "标题对齐", "options": [{ "value": "left", "label": "左对齐" }, { "value": "center", "label": "居中" }], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "顶部小标题", "default": "Before you begin" },
    { "type": "text", "id": "heading", "label": "标题", "default": "Prepare the essentials" },
    { "type": "richtext", "id": "text", "label": "简短说明", "default": "<p>Preparing these materials in advance will make the application faster.</p>" },
    { "type": "header", "content": "布局与尺寸" },
    { "type": "range", "id": "columns", "label": "电脑端卡片列数", "min": 2, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "heading_size", "label": "标题字号", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "heading_size_mobile", "label": "移动端标题字号", "min": 24, "max": 44, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "card_heading_size", "label": "卡片标题字号", "min": 18, "max": 32, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "text_size", "label": "正文字号", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "卡片圆角", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "card_gap", "label": "卡片间距", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_top", "label": "上间距", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "下间距", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "信息卡片",
      "settings": [
        { "type": "text", "id": "badge", "label": "编号或标签", "default": "01" },
        { "type": "text", "id": "heading", "label": "标题", "default": "Information" },
        { "type": "richtext", "id": "text", "label": "内容", "default": "<p>Add the information visitors should prepare or understand.</p>" }
      ]
    },
    {
      "type": "notice",
      "name": "提示文本",
      "settings": [
        { "type": "text", "id": "badge", "label": "标签", "default": "Note" },
        { "type": "text", "id": "heading", "label": "标题", "default": "Important information" },
        { "type": "richtext", "id": "text", "label": "内容", "default": "<p>Add a short notice or reminder.</p>" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "信息卡片",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "notice" }
      ]
    }
  ]
}
{% endschema %}