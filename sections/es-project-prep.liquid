<section
  class="es-project-prep color-{{ section.settings.color_scheme }}"
  style="
    --es-prep-width: {{ section.settings.section_width }}px;
    --es-prep-heading: {{ section.settings.heading_size }}px;
    --es-prep-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --es-prep-card-heading: {{ section.settings.card_heading_size }}px;
    --es-prep-text: {{ section.settings.text_size }}px;
    --es-prep-radius: {{ section.settings.card_radius }}px;
    --es-prep-pt: {{ section.settings.padding_top }}px;
    --es-prep-pb: {{ section.settings.padding_bottom }}px;
    --es-prep-pt-mobile: {{ section.settings.padding_top_mobile }}px;
    --es-prep-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="es-project-prep__inner">
    <div class="es-project-prep__header">
      {% if section.settings.eyebrow != blank %}
        <p class="es-project-prep__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}
        <div class="rte">{{ section.settings.text }}</div>
      {% endif %}
    </div>

    <div class="es-project-prep__grid">
      <article class="es-project-prep__card">
        <span class="es-project-prep__icon">01</span>
        <h3>{{ section.settings.details_heading | escape }}</h3>
        <div class="rte">{{ section.settings.details_text }}</div>
      </article>

      <article class="es-project-prep__card">
        <span class="es-project-prep__icon">02</span>
        <h3>{{ section.settings.files_heading | escape }}</h3>
        <div class="rte">{{ section.settings.files_text }}</div>
      </article>
    </div>

    {% if section.settings.note_text != blank %}
      <div class="es-project-prep__note">
        <strong>{{ section.settings.note_heading | escape }}</strong>
        <div class="rte">{{ section.settings.note_text }}</div>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .es-project-prep {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }

  .es-project-prep__inner {
    width: min(var(--es-prep-width), calc(100% - 40px));
    margin: 0 auto;
    padding-top: var(--es-prep-pt);
    padding-bottom: var(--es-prep-pb);
  }

  .es-project-prep__header {
    max-width: 760px;
    margin-bottom: 42px;
  }

  .es-project-prep__eyebrow {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .es-project-prep__header h2 {
    margin: 0 0 16px;
    font-size: var(--es-prep-heading);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .es-project-prep__header .rte,
  .es-project-prep__card .rte,
  .es-project-prep__note .rte {
    font-size: var(--es-prep-text);
    line-height: 1.7;
  }

  .es-project-prep__header .rte,
  .es-project-prep__card .rte {
    opacity: 0.74;
  }

  .es-project-prep__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .es-project-prep__card {
    padding: 34px;
    border-radius: var(--es-prep-radius);
    background: rgba(var(--color-foreground), 0.045);
  }

  .es-project-prep__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 28px;
    margin-bottom: 36px;
    border-radius: 999px;
    background: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .es-project-prep__card h3 {
    margin: 0 0 16px;
    font-size: var(--es-prep-card-heading);
    line-height: 1.2;
  }

  .es-project-prep__note {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 36px;
    align-items: start;
    margin-top: 22px;
    padding: 28px 32px;
    border: 1px solid rgba(var(--color-foreground), 0.16);
    border-radius: var(--es-prep-radius);
  }

  .es-project-prep__note > strong {
    font-size: 15px;
  }

  .es-project-prep .rte > :first-child {
    margin-top: 0;
  }

  .es-project-prep .rte > :last-child {
    margin-bottom: 0;
  }

  .es-project-prep .rte ul {
    padding-left: 20px;
  }

  .es-project-prep .rte li + li {
    margin-top: 7px;
  }

  @media screen and (max-width: 749px) {
    .es-project-prep__inner {
      width: min(var(--es-prep-width), calc(100% - 28px));
      padding-top: var(--es-prep-pt-mobile);
      padding-bottom: var(--es-prep-pb-mobile);
    }

    .es-project-prep__header h2 {
      font-size: var(--es-prep-heading-mobile);
    }

    .es-project-prep__grid {
      grid-template-columns: 1fr;
    }

    .es-project-prep__card {
      padding: 26px 22px;
    }

    .es-project-prep__icon {
      margin-bottom: 28px;
    }

    .es-project-prep__note {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 24px 22px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "项目申请｜准备资料",
  "class": "section-wrapper",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "配色方案", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "顶部小标题", "default": "Before you begin" },
    { "type": "text", "id": "heading", "label": "标题", "default": "Prepare the essentials" },
    { "type": "richtext", "id": "text", "label": "简短说明", "default": "<p>Preparing these materials in advance will make the application faster.</p>" },
    { "type": "text", "id": "details_heading", "label": "项目资料标题", "default": "Project details" },
    { "type": "richtext", "id": "details_text", "label": "项目资料内容", "default": "<ul><li>Project overview, location, category, and funding goal</li><li>Founder or team introduction</li><li>Current progress, use of funds, delivery plan, and risks</li></ul>" },
    { "type": "text", "id": "files_heading", "label": "文件资料标题", "default": "Files and media" },
    { "type": "richtext", "id": "files_text", "label": "文件资料内容", "default": "<ul><li>Representative project images</li><li>Business registration or supporting PDF when applicable</li><li>Video or cloud-storage link for larger files</li></ul>" },
    { "type": "text", "id": "note_heading", "label": "提示标题", "default": "Large files" },
    { "type": "richtext", "id": "note_text", "label": "提示内容", "default": "<p>ZIP files, videos, source files, and extra documents should be shared through a public Google Drive, Dropbox, or OneDrive link.</p>" },
    { "type": "header", "content": "布局与尺寸" },
    { "type": "range", "id": "section_width", "label": "内容最大宽度", "min": 800, "max": 1400, "step": 20, "unit": "px", "default": 1120 },
    { "type": "range", "id": "heading_size", "label": "标题字号", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 46 },
    { "type": "range", "id": "heading_size_mobile", "label": "移动端标题字号", "min": 24, "max": 44, "step": 1, "unit": "px", "default": 34 },
    { "type": "range", "id": "card_heading_size", "label": "卡片标题字号", "min": 18, "max": 32, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "text_size", "label": "正文字号", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "卡片圆角", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "padding_top", "label": "桌面端上间距", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 92 },
    { "type": "range", "id": "padding_bottom", "label": "桌面端下间距", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 92 },
    { "type": "range", "id": "padding_top_mobile", "label": "移动端上间距", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "移动端下间距", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [{ "name": "项目申请｜准备资料" }]
}
{% endschema %}