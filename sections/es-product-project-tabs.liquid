{%- liquid
  assign comments_first_id = blank
  assign comments_have_content = false

  for block in section.blocks
    case block.type
      when 'comments_liquid'
        if comments_first_id == blank
          assign comments_first_id = block.id
        endif
        if block.settings.liquid != blank or block.settings.show_when_empty
          assign comments_have_content = true
        endif
      when 'comments_text'
        if comments_first_id == blank
          assign comments_first_id = block.id
        endif
        if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank or block.settings.show_when_empty
          assign comments_have_content = true
        endif
    endcase
  endfor

  assign first_tab = blank
  for block in section.blocks
    case block.type
      when 'campaign'
        assign campaign_content = block.settings.content
        if block.settings.use_product_description and product.description != blank
          assign campaign_content = product.description
        endif
        if first_tab == blank and campaign_content != blank
          assign first_tab = 'campaign-' | append: block.id
        endif
      when 'creator'
        if first_tab == blank and block.settings.creator_source != blank
          assign first_tab = 'creator-' | append: block.id
        endif
      when 'faq'
        assign faq_markup = block.settings.faq_source
        assign faq_serialized = faq_markup | replace: '</li>', '|||ES_FAQ_ITEM|||' | replace: '</p>', '|||ES_FAQ_ITEM|||' | replace: '<br>', '|||ES_FAQ_ITEM|||' | replace: '<br/>', '|||ES_FAQ_ITEM|||' | replace: '<br />', '|||ES_FAQ_ITEM|||'
        assign faq_items = faq_serialized | split: '|||ES_FAQ_ITEM|||'
        assign faq_count = 0
        for faq_item in faq_items
          assign faq_text = faq_item | strip_html | strip
          if faq_text != blank
            assign faq_count = faq_count | plus: 1
          endif
        endfor
        if first_tab == blank and faq_count > 0
          assign first_tab = 'faq-' | append: block.id
        endif
      when 'comments_liquid', 'comments_text'
        if first_tab == blank and block.id == comments_first_id and comments_have_content
          assign first_tab = 'comments'
        endif
    endcase
  endfor
-%}

{%- if first_tab != blank -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <es-product-tabs
    id="ESProductTabs-{{ section.id }}"
    class="es-product-tabs color-{{ section.settings.color_scheme }}{% if section.settings.sticky_navigation %} es-product-tabs--sticky{% endif %}"
    style="--es-tabs-font-size: {{ section.settings.tab_font_size }}px; --es-tabs-content-width: {{ section.settings.content_width }}px; --es-tabs-padding-top: {{ section.settings.padding_top }}px; --es-tabs-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="es-product-tabs__nav-shell">
      <div class="es-product-tabs__layout section section--{{ section.settings.section_width }}">
        <div class="es-product-tabs__nav" role="tablist" aria-label="Product project information">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'campaign' -%}
                {%- liquid
                  assign campaign_content = block.settings.content
                  if block.settings.use_product_description and product.description != blank
                    assign campaign_content = product.description
                  endif
                  assign tab_id = 'campaign-' | append: block.id
                -%}
                {%- if campaign_content != blank -%}
                  <button type="button" class="es-product-tabs__tab{% if first_tab == tab_id %} is-active{% endif %}" role="tab" aria-selected="{% if first_tab == tab_id %}true{% else %}false{% endif %}" aria-controls="ESProductTabsPanel-{{ section.id }}-{{ tab_id }}" data-es-tab="{{ tab_id }}">
                    {{ block.settings.tab_label }}
                  </button>
                {%- endif -%}

              {%- when 'creator' -%}
                {%- assign creator = block.settings.creator_source -%}
                {%- assign tab_id = 'creator-' | append: block.id -%}
                {%- if creator != blank -%}
                  <button type="button" class="es-product-tabs__tab{% if first_tab == tab_id %} is-active{% endif %}" role="tab" aria-selected="{% if first_tab == tab_id %}true{% else %}false{% endif %}" aria-controls="ESProductTabsPanel-{{ section.id }}-{{ tab_id }}" data-es-tab="{{ tab_id }}">
                    {{ block.settings.tab_label }}
                  </button>
                {%- endif -%}

              {%- when 'faq' -%}
                {%- liquid
                  assign faq_markup = block.settings.faq_source
                  assign faq_serialized = faq_markup | replace: '</li>', '|||ES_FAQ_ITEM|||' | replace: '</p>', '|||ES_FAQ_ITEM|||' | replace: '<br>', '|||ES_FAQ_ITEM|||' | replace: '<br/>', '|||ES_FAQ_ITEM|||' | replace: '<br />', '|||ES_FAQ_ITEM|||'
                  assign faq_items = faq_serialized | split: '|||ES_FAQ_ITEM|||'
                  assign faq_count = 0
                  for faq_item in faq_items
                    assign faq_text = faq_item | strip_html | strip
                    if faq_text != blank
                      assign faq_count = faq_count | plus: 1
                    endif
                  endfor
                  assign tab_id = 'faq-' | append: block.id
                -%}
                {%- if faq_count > 0 -%}
                  <button type="button" class="es-product-tabs__tab{% if first_tab == tab_id %} is-active{% endif %}" role="tab" aria-selected="{% if first_tab == tab_id %}true{% else %}false{% endif %}" aria-controls="ESProductTabsPanel-{{ section.id }}-{{ tab_id }}" data-es-tab="{{ tab_id }}">
                    {{ block.settings.tab_label }}<sup>{{ faq_count }}</sup>
                  </button>
                {%- endif -%}

              {%- when 'comments_liquid', 'comments_text' -%}
                {%- if block.id == comments_first_id and comments_have_content -%}
                  <button type="button" class="es-product-tabs__tab{% if first_tab == 'comments' %} is-active{% endif %}" role="tab" aria-selected="{% if first_tab == 'comments' %}true{% else %}false{% endif %}" aria-controls="ESProductTabsPanel-{{ section.id }}-comments" data-es-tab="comments">
                    {{ block.settings.tab_label | default: 'Comments' }}
                  </button>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="es-product-tabs__layout es-product-tabs__body-layout section section--{{ section.settings.section_width }}">
      <div class="es-product-tabs__body">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'campaign' -%}
              {%- liquid
                assign campaign_content = block.settings.content
                if block.settings.use_product_description and product.description != blank
                  assign campaign_content = product.description
                endif
                assign tab_id = 'campaign-' | append: block.id
              -%}
              {%- if campaign_content != blank -%}
                <div id="ESProductTabsPanel-{{ section.id }}-{{ tab_id }}" class="es-product-tabs__panel{% if first_tab == tab_id %} is-active{% endif %}" role="tabpanel" data-es-panel="{{ tab_id }}" {% unless first_tab == tab_id %}hidden{% endunless %} {{ block.shopify_attributes }}>
                  <div class="es-product-tabs__content rte">{{ campaign_content }}</div>
                </div>
              {%- endif -%}

            {%- when 'creator' -%}
              {%- liquid
                assign creator = block.settings.creator_source
                assign tab_id = 'creator-' | append: block.id
                assign creator_name = blank
                assign creator_avatar = blank
                assign creator_bio = blank
                assign creator_joined = blank
                assign creator_projects = blank
                assign creator_project_count = 0
                assign creator_url = block.settings.view_more_link
                if creator != blank
                  assign creator_name = creator.display_name.value | default: creator.system.handle
                  assign creator_avatar = creator.avatar.value
                  assign creator_bio = creator.bio
                  assign creator_joined = creator.joined_date.value
                  assign creator_projects = creator.projects_collection.value
                  if creator.system.url != blank
                    assign creator_url = creator.system.url
                  endif
                  if creator_projects != blank
                    if creator_projects.products_count != blank
                      assign creator_project_count = creator_projects.products_count
                    elsif creator_projects.size != blank
                      assign creator_project_count = creator_projects.size
                    endif
                  endif
                endif
              -%}
              {%- if creator != blank -%}
                <div id="ESProductTabsPanel-{{ section.id }}-{{ tab_id }}" class="es-product-tabs__panel{% if first_tab == tab_id %} is-active{% endif %}" role="tabpanel" data-es-panel="{{ tab_id }}" {% unless first_tab == tab_id %}hidden{% endunless %} {{ block.shopify_attributes }}>
                  <div class="es-product-tabs__content">
                    <article class="es-project-creator">
                      {%- if block.settings.heading != blank -%}
                        <h2 class="es-project-creator__title">{{ block.settings.heading }}</h2>
                      {%- endif -%}

                      <div class="es-project-creator__profile">
                        {%- if creator_avatar != blank -%}
                          {{ creator_avatar | image_url: width: 240 | image_tag: class: 'es-project-creator__avatar', loading: 'lazy', alt: creator_name }}
                        {%- else -%}
                          <div class="es-project-creator__avatar es-project-creator__avatar--fallback" aria-hidden="true">{{ creator_name | slice: 0 | upcase }}</div>
                        {%- endif -%}
                        <div class="es-project-creator__identity">
                          <h3 class="es-project-creator__name">{{ creator_name }}</h3>
                          {%- if creator_joined != blank -%}
                            <span class="es-project-creator__joined">Joined {{ creator_joined | date: '%B %Y' }}</span>
                          {%- endif -%}
                        </div>
                      </div>

                      <div class="es-project-creator__stats">
                        <div class="es-project-creator__stat">
                          <strong>{{ creator_project_count }}</strong>
                          <span>{% if creator_project_count == 1 %}created project{% else %}created projects{% endif %}</span>
                        </div>
                        {%- if creator_joined != blank -%}
                          <div class="es-project-creator__stat">
                            <strong>{{ creator_joined | date: '%B %Y' }}</strong>
                            <span>account created</span>
                          </div>
                        {%- endif -%}
                      </div>

                      {%- if creator_bio != blank -%}
                        <div class="es-project-creator__bio rte">{{ creator_bio | metafield_tag }}</div>
                      {%- endif -%}

                      {%- if creator_url != blank and block.settings.view_more_label != blank -%}
                        <a href="{{ creator_url }}" class="button button--secondary es-project-creator__view-more">{{ block.settings.view_more_label }}</a>
                      {%- endif -%}
                    </article>
                  </div>
                </div>
              {%- endif -%}

            {%- when 'faq' -%}
              {%- liquid
                assign faq_markup = block.settings.faq_source
                assign faq_serialized = faq_markup | replace: '</li>', '|||ES_FAQ_ITEM|||' | replace: '</p>', '|||ES_FAQ_ITEM|||' | replace: '<br>', '|||ES_FAQ_ITEM|||' | replace: '<br/>', '|||ES_FAQ_ITEM|||' | replace: '<br />', '|||ES_FAQ_ITEM|||'
                assign faq_items = faq_serialized | split: '|||ES_FAQ_ITEM|||'
                assign faq_count = 0
                for faq_item in faq_items
                  assign faq_text = faq_item | strip_html | strip
                  if faq_text != blank
                    assign faq_count = faq_count | plus: 1
                  endif
                endfor
                assign tab_id = 'faq-' | append: block.id
              -%}
              {%- if faq_count > 0 -%}
                <div id="ESProductTabsPanel-{{ section.id }}-{{ tab_id }}" class="es-product-tabs__panel{% if first_tab == tab_id %} is-active{% endif %}" role="tabpanel" data-es-panel="{{ tab_id }}" {% unless first_tab == tab_id %}hidden{% endunless %} {{ block.shopify_attributes }}>
                  <div class="es-product-tabs__content">
                    {%- if block.settings.heading != blank -%}
                      <h2 class="es-product-tabs__heading">{{ block.settings.heading }}</h2>
                    {%- endif -%}
                    <div class="es-project-faqs">
                      {%- assign rendered_faq_index = 0 -%}
                      {%- for faq_item in faq_items -%}
                        {%- liquid
                          assign faq_text = faq_item | strip_html | strip
                          assign faq_question = faq_text
                          assign faq_answer = blank
                          if faq_text contains '？'
                            assign faq_question = faq_text | split: '？' | first | strip
                            assign faq_answer = faq_text | remove_first: faq_question | remove_first: '？' | strip
                          elsif faq_text contains '?'
                            assign faq_question = faq_text | split: '?' | first | strip
                            assign faq_answer = faq_text | remove_first: faq_question | remove_first: '?' | strip
                          endif
                        -%}
                        {%- if faq_text != blank -%}
                          {%- assign rendered_faq_index = rendered_faq_index | plus: 1 -%}
                          <details class="es-project-faq" {% if rendered_faq_index == 1 and block.settings.open_first_faq %}open{% endif %}>
                            <summary class="es-project-faq__question">
                              <span>{{ faq_question }}</span>
                              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 9 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </summary>
                            {%- if faq_answer != blank -%}
                              <div class="es-project-faq__answer rte">{{ faq_answer | newline_to_br }}</div>
                            {%- endif -%}
                          </details>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              {%- endif -%}

            {%- when 'comments_liquid', 'comments_text' -%}
              {%- if block.id == comments_first_id and comments_have_content -%}
                <div id="ESProductTabsPanel-{{ section.id }}-comments" class="es-product-tabs__panel{% if first_tab == 'comments' %} is-active{% endif %}" role="tabpanel" data-es-panel="comments" {% unless first_tab == 'comments' %}hidden{% endunless %} {{ block.shopify_attributes }}>
                  <div class="es-product-tabs__content es-product-tabs__comments">
                    {%- for comments_block in section.blocks -%}
                      {%- case comments_block.type -%}
                        {%- when 'comments_liquid' -%}
                          {%- if comments_block.settings.liquid != blank or comments_block.settings.show_when_empty -%}
                            <div class="es-project-comments__liquid" {% unless comments_block.id == block.id %}{{ comments_block.shopify_attributes }}{% endunless %}>{{ comments_block.settings.liquid }}</div>
                          {%- endif -%}
                        {%- when 'comments_text' -%}
                          {%- if comments_block.settings.heading != blank or comments_block.settings.text != blank or comments_block.settings.button_label != blank or comments_block.settings.show_when_empty -%}
                            <div class="es-project-comments__text" {% unless comments_block.id == block.id %}{{ comments_block.shopify_attributes }}{% endunless %}>
                              {%- if comments_block.settings.heading != blank -%}<h2>{{ comments_block.settings.heading }}</h2>{%- endif -%}
                              {%- if comments_block.settings.text != blank -%}<div class="rte">{{ comments_block.settings.text }}</div>{%- endif -%}
                              {%- if comments_block.settings.button_label != blank and comments_block.settings.button_link != blank -%}
                                <a href="{{ comments_block.settings.button_link }}" class="button">{{ comments_block.settings.button_label }}</a>
                              {%- endif -%}
                            </div>
                          {%- endif -%}
                      {%- endcase -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </es-product-tabs>
{%- endif -%}

{% stylesheet %}
  .es-product-tabs {
    display: block;
    color: var(--color-foreground);
    background: var(--color-background);
  }

  .es-product-tabs__layout {
    padding-block: 0;
  }

  .es-product-tabs__nav,
  .es-product-tabs__body {
    grid-column: 2;
    min-width: 0;
  }

  .es-product-tabs__nav-shell {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }

  .es-product-tabs--sticky .es-product-tabs__nav-shell {
    position: sticky;
    top: 0;
  }

  .es-product-tabs__nav {
    display: flex;
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .es-product-tabs__nav::-webkit-scrollbar {
    display: none;
  }

  .es-product-tabs__tab {
    position: relative;
    flex: 0 0 auto;
    padding: 20px 0 18px;
    border: 0;
    color: var(--color-foreground);
    background: transparent;
    font: inherit;
    font-size: var(--es-tabs-font-size);
    cursor: pointer;
  }

  .es-product-tabs__tab::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 3px;
    background: currentColor;
    content: '';
    opacity: 0;
    transform: scaleX(.4);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .es-product-tabs__tab.is-active {
    font-weight: 700;
  }

  .es-product-tabs__tab.is-active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .es-product-tabs__tab sup {
    margin-left: 4px;
    font-size: .65em;
    color: currentColor;
    vertical-align: super;
  }

  .es-product-tabs__body {
    padding-top: var(--es-tabs-padding-top);
    padding-bottom: var(--es-tabs-padding-bottom);
  }

  .es-product-tabs__panel[hidden] {
    display: none;
  }

  .es-product-tabs__content {
    width: min(100%, var(--es-tabs-content-width));
    margin-inline: 0;
  }

  .es-product-tabs__heading,
  .es-project-creator__title {
    margin: 0 0 28px;
    font-family: var(--font-heading--family);
  }

  .es-project-creator {
    padding: clamp(24px, 4vw, 44px);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-background);
  }

  .es-project-creator__profile {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .es-project-creator__avatar {
    display: block;
    width: 96px;
    height: 96px;
    flex: 0 0 96px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    object-fit: cover;
    background: rgb(var(--color-foreground-rgb) / .06);
  }

  .es-project-creator__avatar--fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
    font-weight: 700;
  }

  .es-project-creator__identity {
    min-width: 0;
  }

  .es-project-creator__name {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .es-project-creator__joined {
    display: block;
    margin-top: 8px;
    color: rgb(var(--color-foreground-rgb) / .62);
  }

  .es-project-creator__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 28px;
    padding-block: 22px;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .es-project-creator__stat {
    display: grid;
    gap: 3px;
  }

  .es-project-creator__stat strong {
    font-family: var(--font-heading--family);
    font-size: 1.15rem;
  }

  .es-project-creator__stat span {
    color: rgb(var(--color-foreground-rgb) / .68);
  }

  .es-project-creator__bio {
    margin-top: 28px;
  }

  .es-project-creator__view-more {
    width: 100%;
    margin-top: 28px;
    text-align: center;
  }

  .es-project-faqs {
    display: grid;
    gap: 14px;
  }

  .es-project-faq {
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  .es-project-faq__question {
    display: flex;
    min-height: 68px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 20px;
    cursor: pointer;
    list-style: none;
    font-size: 1.1em;
    font-weight: 600;
  }

  .es-project-faq__question::-webkit-details-marker {
    display: none;
  }

  .es-project-faq__question svg {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
    transition: transform 180ms ease;
  }

  .es-project-faq[open] .es-project-faq__question svg {
    transform: rotate(180deg);
  }

  .es-project-faq__answer {
    padding: 0 20px 22px;
  }

  .es-product-tabs__comments {
    display: grid;
    gap: 28px;
  }

  .es-project-comments__text h2 {
    margin-top: 0;
  }

  .es-project-comments__text .button {
    margin-top: 18px;
  }

  @media (max-width: 749px) {
    .es-product-tabs__nav {
      gap: 28px;
    }

    .es-product-tabs__tab {
      padding-top: 16px;
      padding-bottom: 14px;
    }

    .es-project-creator {
      padding: 20px;
    }

    .es-project-creator__profile {
      gap: 16px;
    }

    .es-project-creator__avatar {
      width: 72px;
      height: 72px;
      flex-basis: 72px;
    }

    .es-project-creator__stats {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('es-product-tabs')) {
    customElements.define('es-product-tabs', class extends HTMLElement {
      connectedCallback() {
        if (this.dataset.bound === 'true') return;
        this.dataset.bound = 'true';
        this.tabs = Array.from(this.querySelectorAll('[data-es-tab]'));
        this.panels = Array.from(this.querySelectorAll('[data-es-panel]'));
        this.tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => this.activate(tab.dataset.esTab));
          tab.addEventListener('keydown', (event) => {
            if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
            event.preventDefault();
            let nextIndex = index;
            if (event.key === 'ArrowRight') nextIndex = (index + 1) % this.tabs.length;
            if (event.key === 'ArrowLeft') nextIndex = (index - 1 + this.tabs.length) % this.tabs.length;
            if (event.key === 'Home') nextIndex = 0;
            if (event.key === 'End') nextIndex = this.tabs.length - 1;
            this.tabs[nextIndex].focus();
            this.activate(this.tabs[nextIndex].dataset.esTab);
          });
        });
      }

      activate(name) {
        this.tabs.forEach((tab) => {
          const active = tab.dataset.esTab === name;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        this.panels.forEach((panel) => {
          const active = panel.dataset.esPanel === name;
          panel.hidden = !active;
          panel.classList.toggle('is-active', active);
        });
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "产品项目 Tabs",
  "tag": "section",
  "class": "section-es-product-project-tabs",
  "max_blocks": 20,
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "内容宽度",
      "default": "page-width",
      "options": [
        { "value": "page-width", "label": "页面宽度" },
        { "value": "full-width", "label": "全宽" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "颜色方案", "default": "scheme-1" },
    { "type": "checkbox", "id": "sticky_navigation", "label": "启用 Sticky Tab 导航", "default": true },
