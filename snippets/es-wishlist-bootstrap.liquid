{%- liquid
  assign es_wishlist_enabled = true
  if settings.es_wishlist_enable == false
    assign es_wishlist_enabled = false
  endif

  assign es_sync_enabled = true
  if settings.es_wishlist_sync == false
    assign es_sync_enabled = false
  endif
-%}
<style>
  :root {
    --es-card-title-size: {{ settings.es_card_title_size | default: 16 }}px;
    --es-card-description-size: {{ settings.es_card_description_size | default: 14 }}px;
    --es-media-accent-height: {% if settings.es_media_accent_enable == false %}0px{% else %}{{ settings.es_media_accent_height | default: 6 }}px{% endif %};
    --es-media-accent-color: {{ settings.es_media_accent_color | default: '#00c875' }};
    --es-card-content-padding-y: {{ settings.es_card_content_padding_y | default: 20 }}px;
    --es-card-content-padding-y-mobile: {{ settings.es_card_content_padding_y_mobile | default: 14 }}px;
  }
</style>
<script>
  window.EnterpriseSharesWishlist = Object.assign(window.EnterpriseSharesWishlist || {}, {
    enabled: {{ es_wishlist_enabled | json }},
    syncEnabled: {{ es_sync_enabled | json }},
    proxyPath: {{ settings.es_wishlist_proxy | default: '/apps/enterprise-wishlist' | json }},
    customerId: {% if customer %}{{ customer.id | json }}{% else %}null{% endif %},
    routesRoot: {{ routes.root_url | json }},
    storageKey: 'enterprise_shares_wishlist'
  });
</script>
{{ 'es-project-card.css' | asset_url | stylesheet_tag }}
{{ 'es-project-card-overrides.css' | asset_url | stylesheet_tag }}
<script src="{{ 'es-project-card.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'es-wishlist.js' | asset_url }}" defer="defer"></script>
